# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL: The Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# VITE_SUPABASE_ANON_KEY: The public anonymous client key for browser access (never use service_role)
# When these two variables are configured, RBflix connects directly to the Supabase database.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-public-anon-key"

# VITE_API_URL: Optional REST API backend endpoint (used if not connecting directly via Supabase)
# VITE_API_URL="https://api.rbflix.com/v1"

# VITE_TMDB_API_KEY: Optional TMDB v3 API Key for real-time TMDB credits, seasons, and actor metadata
# When not set, RBflix seamlessly provides metadata from the database and catalog.
VITE_TMDB_API_KEY="your-tmdb-api-key"
